# Entorno
PORT=5000
NODE_ENV=development

# Origen permitido por CORS (dominio del frontend desplegado, p. ej. Vercel)
FRONTEND_URL=https://tu-dominio.vercel.app

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/sistema_documental?retryWrites=true&w=majority

# JWT
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_seguro
JWT_EXPIRES_IN=7d

# ============================================================
# IA gratuita (tercer corte)
# ============================================================
# Orden de proveedores de chat.
# auto = Gemini -> Groq -> OpenRouter/OpenAI -> Ollama (solo los configurados)
AI_PROVIDER=auto
AI_FALLBACK_PROVIDERS=groq,openrouter,ollama
AI_CHAT_TIMEOUT_MS=60000
AI_CHAT_MAX_RETRIES=0

# Gemini (nivel gratuito). Obtén la clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Endpoint nativo para embeddings con dimensión fija
GEMINI_NATIVE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Modelo estable con nivel gratuito. Alternativa de mayor calidad: gemini-3.8-flash
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# Modelo multimodal para leer facturas (Semana 3)
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Debe coincidir con la dimensión del índice de Atlas Vector Search.
# El índice de este proyecto usa 1536 dimensiones; no lo cambies sin recrearlo.
GEMINI_EMBEDDING_DIMENSIONS=1536

# Groq (nivel gratuito, respaldo de chat). https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Ollama local (plan B). Actívalo solo si lo tienes corriendo.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Embeddings: auto = Gemini -> Ollama -> OpenRouter/OpenAI.
# Debe coincidir con la dimensión del índice de Atlas Vector Search.
# Gemini admite 768, 1536 o 3072; Ollama usa 768 y OpenRouter/OpenAI 1536.
# Este proyecto fija Gemini en 1536 para conservar el índice existente.
EMBEDDINGS_PROVIDER=auto
# EMBEDDING_DIMENSIONS=1536

# Compatibilidad con el proveedor anterior (OpenRouter / DeepSeek / OpenAI).
# Se usa como respaldo de chat y como opción de embeddings de 1536 dimensiones.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=deepseek/deepseek-chat
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
# Modelo multimodal de OpenRouter para facturas (Semana 3)
OPENAI_VISION_MODEL=google/gemini-2.5-flash

# Visión por computador (Semana 3)
# Si la confianza es menor, el usuario debe revisar antes de guardar.
VISION_MIN_CONFIDENCE=0.85
VISION_TIMEOUT_MS=90000
VISION_MAX_RETRIES=0
# Tope de tokens de salida para el JSON de la factura
VISION_MAX_TOKENS=4096

# Límites
MAX_FILE_SIZE_MB=10

# Procesamiento IA (opcionales)
AI_CHUNK_SIZE=1500
AI_CHUNK_OVERLAP=150
AI_MAX_CHUNKS=20
AI_CHAT_TEXT_LIMIT=6000
# Índice de Atlas Vector Search sobre la colección documentchunks
AI_VECTOR_SEARCH_INDEX=vector_index
# Tiempo (ms) para considerar colgado un documento en processing y marcarlo error
AI_PROCESS_STALE_MS=300000
