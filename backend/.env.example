# Entorno
PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/sistema_documental?retryWrites=true&w=majority

# JWT
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_seguro
JWT_EXPIRES_IN=7d

# Proveedor de IA: Google Gemini
# (Los nombres legacy OPENAI_API_KEY / OPENAI_MODEL / OPENAI_EMBEDDING_MODEL
#  también se leen como fallback para no romper archivos .env antiguos.)
GEMINI_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Dimensiones del embedding Gemini (por defecto 768; < 3072 se normaliza en código)
GEMINI_EMBEDDING_DIMENSIONS=768

# Límites
MAX_FILE_SIZE_MB=10

# Procesamiento IA (opcionales)
AI_CHUNK_SIZE=1500
AI_CHUNK_OVERLAP=150
AI_MAX_CHUNKS=20
AI_CHAT_TEXT_LIMIT=6000
# Tiempo (ms) para considerar colgado un documento en processing y marcarlo error
AI_PROCESS_STALE_MS=300000
